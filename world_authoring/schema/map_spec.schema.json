{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-rpg.local/schemas/map_spec.schema.json",
  "title": "MapSpec v1",
  "description": "Canonical language-neutral contract for deterministic map authoring. The version field is the document-contract version: incompatible changes require a new version and an explicit migration, rather than silently changing v1 semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "map"],
  "properties": {
    "version": { "const": "1.0", "description": "MapSpec contract version. This schema is the canonical definition of version 1.0." },
    "map": { "$ref": "#/$defs/mapMetadata" },
    "music": { "$ref": "#/$defs/music" },
    "terrain": { "$ref": "#/$defs/terrain" },
    "regions": { "type": "array", "items": { "$ref": "#/$defs/region" }, "uniqueItems": true },
    "vegetation": { "type": "array", "items": { "$ref": "#/$defs/vegetationPlacement" }, "uniqueItems": true },
    "structures": { "type": "array", "items": { "$ref": "#/$defs/structure" }, "uniqueItems": true },
    "hills": { "type": "array", "items": { "$ref": "#/$defs/assetPlacement" }, "uniqueItems": true, "description": "Terrain-reshaping heightfield stamps, compiled before every other terrain-dependent entity. See ADR-007." },
    "walls": { "type": "array", "items": { "$ref": "#/$defs/wall" }, "uniqueItems": true },
    "actors": { "type": "array", "items": { "$ref": "#/$defs/actor" }, "uniqueItems": true },
    "player": { "$ref": "#/$defs/player" },
    "spawn_points": { "type": "array", "items": { "$ref": "#/$defs/spawnPoint" }, "uniqueItems": true },
    "interactables": { "type": "array", "items": { "$ref": "#/$defs/interactable" }, "uniqueItems": true },
    "pickups": { "type": "array", "items": { "$ref": "#/$defs/pickup" }, "uniqueItems": true },
    "rivers": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
    "roads": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
    "bridges": { "type": "array", "items": { "$ref": "#/$defs/bridge" }, "uniqueItems": true },
    "objectives": { "type": "array", "items": { "$ref": "#/$defs/objective" }, "uniqueItems": true },
    "encounters": { "type": "array", "items": { "$ref": "#/$defs/encounter" }, "uniqueItems": true },
    "dialogs": { "type": "array", "items": { "$ref": "#/$defs/dialog" }, "uniqueItems": true, "description": "Reusable conversation graphs referenced by actor.dialog. Dialog text and graph navigation are presentation; only the check roll, disposition changes, and combat start reach the resolver." },
    "doors": { "type": "array", "items": { "$ref": "#/$defs/door" }, "uniqueItems": true }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^(?!res://)[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "description": "Stable identifier, compatible with B1 AssetCatalog IDs. Resource paths, including res:// paths, are not identifiers."
    },
    "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+(?:\\.[0-9]+)?$" },
    "vector2": {
      "type": "array",
      "description": "Absolute [east_m, north_m] coordinates measured from the southwest map corner.",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_m", "height_m"],
      "properties": {
        "width_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 256 },
        "height_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 256 }
      }
    },
    "mapMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "preset", "seed", "bounds"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "preset": { "enum": ["encounter", "small", "medium"] },
        "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "bounds": { "$ref": "#/$defs/bounds" },
        "asset_catalog_version": { "$ref": "#/$defs/version" },
        "generator_version": { "$ref": "#/$defs/version" }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ambient", "battle"],
      "properties": {
        "ambient": { "enum": ["ambient_light_1", "ambient_night_3"] },
        "battle": { "enum": ["battle_action_1", "battle_action_2"] }
      }
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": { "enum": ["flat", "rolling_hills", "valley"] },
        "surface": { "enum": ["grass", "sand", "dirt", "stone"], "default": "grass", "description": "Repeated visual material applied to the generated terrain mesh." },
        "generator_version": { "$ref": "#/$defs/version" }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "polygon"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "polygon": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/vector2" } },
        "vegetation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile"],
          "properties": {
            "profile": { "enum": ["temperate_sparse", "temperate_dense", "old_growth", "meadow", "rocky_scrub", "thicket", "none"] },
            "density": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "assetPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asset", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "asset": { "$ref": "#/$defs/stableId" },
        "position": { "$ref": "#/$defs/vector2" },
        "rotation_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 }
      }
    },
    "vegetationPlacement": { "$ref": "#/$defs/assetPlacement" },
    "structure": { "$ref": "#/$defs/assetPlacement" },
    "wall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asset", "control_points"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "asset": { "$ref": "#/$defs/stableId" },
        "control_points": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/vector2" } }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "archetype", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "archetype": { "$ref": "#/$defs/stableId" },
        "side": { "type": "string", "enum": ["heroes", "enemies"], "default": "enemies", "description": "Combat team. Enemy actors can detect the player and start an encounter." },
        "stat_block": { "$ref": "#/$defs/stableId", "description": "ActorDefinition id used to build this actor's authoritative stats. Omitted falls back to the runtime default block." },
        "dialog": { "$ref": "#/$defs/stableId", "description": "Id of an entry in the top-level `dialogs` array. Actors without one cannot be talked to." },
        "initial_disposition": { "type": "string", "enum": ["hostile", "neutral"], "default": "hostile", "description": "Social stance, independent of `side`. Only hostile actors trigger encounter detection; a neutral actor can be approached and talked to until provoked." },
        "position": { "$ref": "#/$defs/vector2" },
        "rotation_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "character_asset": { "$ref": "#/$defs/stableId", "description": "AssetCatalog character ID used by the compiled-map player." }
      }
    },
    "spawnPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position"],
      "properties": { "id": { "$ref": "#/$defs/stableId" }, "position": { "$ref": "#/$defs/vector2" } }
    },
    "interactable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "asset", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "kind": { "enum": ["chest", "door", "lever", "barrel", "prop"], "description": "Runtime behaviour. 'prop' is non-interactive dressing: it is placed and collision-checked, but never registered as a runtime interactable." },
        "asset": { "$ref": "#/$defs/stableId" },
        "position": { "$ref": "#/$defs/vector2" },
        "rotation_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "contents": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "description": "Item IDs granted once when a container is first opened." }
      }
    },
    "pickup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asset", "item_id", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "asset": { "$ref": "#/$defs/stableId" },
        "item_id": { "$ref": "#/$defs/stableId", "description": "Item ID granted when the pickup is collected." },
        "position": { "$ref": "#/$defs/vector2" },
        "rotation_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "control_points"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "control_points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/vector2" } },
        "width_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 24 }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "position": { "$ref": "#/$defs/vector2" },
        "radius_m": { "type": "number", "exclusiveMinimum": 0, "default": 2.0 },
        "requires_encounter_ids": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true, "default": [] }
      }
    },
    "encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position", "actor_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "position": { "$ref": "#/$defs/vector2" },
        "trigger_radius_m": { "type": "number", "exclusiveMinimum": 0, "default": 8.0 },
        "actor_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true }
      }
    },
    "dialog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "root", "nodes"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "root": { "$ref": "#/$defs/stableId", "description": "Id of the node in `nodes` this dialog opens on." },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/dialogNode" }, "uniqueItems": true }
      }
    },
    "dialogNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "speaker": { "type": "string", "maxLength": 64, "description": "Display name shown above the line. Omitted uses the addressed actor's stat block display name." },
        "text": { "type": "string", "minLength": 1, "maxLength": 600 },
        "options": { "type": "array", "items": { "$ref": "#/$defs/dialogOption" } }
      }
    },
    "dialogOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "outcome"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
        "check": { "$ref": "#/$defs/dialogCheck" },
        "outcome": { "$ref": "#/$defs/dialogOutcome", "description": "Taken unconditionally, or on a successful `check`." },
        "failure_outcome": { "$ref": "#/$defs/dialogOutcome", "description": "Taken when `check` fails. Required whenever `check` is present." }
      },
      "if": { "required": ["check"] },
      "then": { "required": ["failure_outcome"] }
    },
    "dialogCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ability", "dc"],
      "properties": {
        "ability": { "enum": ["strength", "dexterity", "constitution", "intelligence", "wisdom", "charisma"] },
        "skill": { "enum": ["athletics", "acrobatics", "stealth", "insight", "perception", "persuasion", "deception", "intimidation"], "description": "Narration label only. The modifier comes from `ability` plus `proficient`." },
        "dc": { "type": "integer", "minimum": 1, "maximum": 30 },
        "proficient": { "type": "boolean", "default": false }
      }
    },
    "dialogOutcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "next": { "$ref": "#/$defs/stableId", "description": "Id of the next node in this dialog. Omitted closes the dialog." },
        "effect": { "enum": ["none", "end", "start_combat", "pacify_encounter"], "default": "none", "description": "pacify_encounter sets every actor in the speaker's encounter to neutral; start_combat opens that encounter." }
      }
    },
    "door": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position", "initial_state", "required_state"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "position": { "$ref": "#/$defs/vector2" },
        "initial_state": { "enum": ["open", "closed"] },
        "required_state": { "enum": ["open", "closed"] }
      }
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asset", "position", "river_id", "road_id"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "asset": { "$ref": "#/$defs/stableId" },
        "position": { "$ref": "#/$defs/vector2" },
        "river_id": { "$ref": "#/$defs/stableId" },
        "road_id": { "$ref": "#/$defs/stableId" }
      }
    }
  }
}
